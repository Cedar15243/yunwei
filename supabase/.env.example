AUTO_MIGRATE=true
OPS_GLASSES_API_KEY=replace-with-random-long-secret
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_VISION_MODEL=qwen3-vl-plus
OPENAI_TRANSCRIBE_API_KEY=replace-with-stt-api-key
OPENAI_TRANSCRIBE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_TRANSCRIBE_MODEL=fun-asr-realtime
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_FUNASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
DASHSCOPE_FUNASR_MODEL=fun-asr-realtime
V9_GATEWAY_SYNC_TOKEN_SHA256=replace-with-64-character-sha256
V9_GATEWAY_SYNC_ORGANIZATION_ID=org-huafang
V9_GATEWAY_SYNC_USER_ID=user-field-engineer
V9_GATEWAY_SYNC_DEVICE_ID=air3-REPLACE_WITH_DEVICE_ID
V9_VOICEPRINT_ADMIN_URL=https://your-v9-gateway.example.com/v9-ops
V9_VOICEPRINT_ADMIN_TOKEN=replace-with-voiceprint-admin-bearer-token
V9_KNOWLEDGE_PARSER_URL=https://your-v9-gateway.example.com/v9-ops
V9_KNOWLEDGE_PARSER_TOKEN=replace-with-knowledge-parser-bearer-token
V9_DEVICE_ACTIVATION_BACKEND_BASE_URL=https://your-v9-gateway.example.com/v9-ops
V9_DEVICE_ACTIVATION_POLICY_VERSION=v9-production-1
OPS_ACCOUNT_RECOVERY_REDIRECT_URL=https://your-v9-ops.example.com/
# Dingdang fast path:
# POST /sessions/:sessionId/images only stores the image and returns image_id.
# WS /sessions/:sessionId/asr proxies Fun-ASR; GPT is not called by ASR.
# POST /sessions/:sessionId/diagnose/stream streams GPT output after final_text + image_id.
DEFAULT_ASSET_TAG=replace-with-real-registered-asset-tag
DEFAULT_TARGET_SSH_PORT=22
DEFAULT_TARGET_APP_PORT=
# Use disabled until a real controlled probe is configured. Production acceptance requires tcp or http.
REMOTE_PROBE_MODE=disabled
REMOTE_PROBE_URL=https://your-controlled-probe.example.com/check
